{
  "name": "ludo-monorepo-root",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "pnpm --dir ludo dev",
    "dev:server": "pnpm --dir ludo --filter @ludo/server dev",
    "dev:web": "pnpm --dir ludo --filter @ludo/web dev",
    "build": "pnpm --dir ludo -r build",
    "test": "pnpm --dir ludo test",
    "test:engine": "pnpm --dir ludo --filter @ludo/game-engine test",
    "test:server": "pnpm --dir ludo --filter @ludo/server test",
    "test:all": "pnpm --dir ludo -r --if-present test",
    "sim:20": "pnpm --dir ludo --filter @ludo/server exec tsx test/run-20-matches.mts",
    "qa": "pnpm --dir ludo --filter @ludo/server exec tsx test/ludo-qa-match.mts",
    "qa:players": "pnpm --dir ludo --filter @ludo/server exec tsx test/multiplayer-qa-2-3-4-players.mts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
