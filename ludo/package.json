{
  "name": "ludo-local",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "test": "pnpm --filter @ludo/game-engine test",
    "test:engine": "pnpm --filter @ludo/game-engine test",
    "test:server": "pnpm --filter @ludo/server test",
    "test:all": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @ludo/server --filter @ludo/web dev"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
