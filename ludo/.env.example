# Copy the values you need into your shell, or set them in your host's dashboard.
# The server reads the process environment; it does not load .env files itself.
# Never commit a real .env, connection string or secret.

# HTTP/WebSocket port for the API (default 3001).
PORT=3001

# Exact browser origin allowed to call the API. Comma-separate several origins.
# "*" is rejected when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# Optional PostgreSQL connection string. Leave empty to keep rooms in memory.
DATABASE_URL=

# HMAC key used to hash session tokens. Required in production, minimum 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Build-time API origin for the web client (Vite). No trailing slash.
VITE_SERVER_URL=http://localhost:3001
